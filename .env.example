# ── Shared feature database ──────────────────────────────────────────
# Point this at the SAME Turso database your bot deployment uses. That's
# what lets the trainer and the bot share the feature bank without any
# manual file transfer. If left unset, training falls back to a local
# pokemon.db SQLite file (fine for test runs, but the bot won't see it).
TURSO_URL=
TURSO_AUTH_TOKEN=
# DB_PATH=pokemon.db   # only used if TURSO_URL is unset

# ── Hugging Face ──────────────────────────────────────────────────────
# Needed to stream the training dataset, and (optionally) to publish the
# finished model with publish_model.py below.
HF_TOKEN=
DATASET_NAME=SpreadSheets/Poketwo-Spawn-Images

# ── Data volume knobs ─────────────────────────────────────────────────
# The dataset averages ~35 images/species across ~1,649 species - going
# much above ~30-40 mostly just means the rarer species get capped by
# what actually exists, not by this setting.
MAX_IMAGES_PER_SPECIES=40
VAL_IMAGES_PER_SPECIES=6
MAX_SPECIES=0            # 0 = no cap

# ── Head training ─────────────────────────────────────────────────────
HEAD_EPOCHS=80
HEAD_LR=1e-3
HEAD_BATCH=256
HEAD_WEIGHT_DECAY=1e-2
HEAD_FEATURE_DROPOUT=0.2
HEAD_PATIENCE=15

# ── Throughput / memory tuning ────────────────────────────────────────
# Match these to whatever this trainer deployment's own CPU allocation
# is (separate box from the bot, so size it for THIS container).
BATCH_SIZE=32             # declared but not read elsewhere in train_model.py - safe to ignore
STREAM_BATCH_SIZE=20       # this is the one that actually controls memory/throughput
DISK_CACHE=true
DISK_CACHE_DIR=image_cache
REPLACE_DB_FEATURES=false

# ── Output paths ──────────────────────────────────────────────────────
MODEL_OUTPUT=models/pokemon_classifier.pt
ONNX_MODEL_PATH=models/pokemon_classifier.onnx

# ── Optional: publish the finished model so the bot deployment can pull it ──
# Only needed if you use publish_model.py (see README). Any HF model repo
# you own, e.g. "yourname/pokemon-classifier".
HF_MODEL_REPO=
