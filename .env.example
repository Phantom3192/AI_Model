# ── API server ───────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
# Shared secret the bot sends as the X-API-Key header. Set it whenever the server is reachable
# from the internet. Without it the API is open and /admin/* (train, reload) is disabled.
API_KEY=

# ── Model files ──────────────────────────────────────────────────────
# Training writes MODEL_OUTPUT; the server reads it. The .onnx is built from the .pt.
MODEL_OUTPUT=models/pokemon_classifier.pt
ONNX_MODEL_PATH=models/pokemon_classifier.onnx
# Re-export the .onnx automatically when it's missing or was made from a different .pt
# (runs export_onnx.py as a subprocess, so it needs torch: requirements-train.txt).
AUTO_EXPORT_ONNX=true

# ── Feature database (the same one the bot used before) ──────────────
TURSO_URL=
TURSO_AUTH_TOKEN=
# DB_PATH=pokemon.db   # only used if TURSO_URL is unset

# ── Matching (same meaning/defaults as the old bot settings) ─────────
TOP_K=5
NEAR_EXACT_SIM=0.95
LEARN_DUP_SIM=0.995
# Default for the "confident" flag in responses; a request can override it with ?threshold=
CONFIDENCE_THRESHOLD=0.5

# ── Throughput ───────────────────────────────────────────────────────
ONNX_THREADS=1          # threads per model call; raise on a multi-core box
INFER_CONCURRENCY=2     # model calls running at once
MAX_UPLOAD_MB=10
MAX_BATCH=32

# ── Training (POST /admin/train runs run_training.py with these) ─────
HF_TOKEN=
DATASET_NAME=SpreadSheets/Poketwo-Spawn-Images
# Set these explicitly: if left unset, train_model.py defaults to only 100 species / 10 images each.
MAX_SPECIES=0                 # 0 = all species
MAX_IMAGES_PER_SPECIES=40
VAL_IMAGES_PER_SPECIES=6
# true = wipe the bank before writing the new one (right for a retrain: old vectors came from the
# old model and don't match the new one). Needs "Extra pokemons.zip" present, or those species vanish.
REPLACE_DB_FEATURES=true
HEAD_EPOCHS=80
HEAD_LR=1e-3
HEAD_BATCH=256
HEAD_WEIGHT_DECAY=1e-2
HEAD_FEATURE_DROPOUT=0.2
HEAD_PATIENCE=15
STREAM_BATCH_SIZE=20          # controls training memory/throughput
DISK_CACHE=true
DISK_CACHE_DIR=image_cache
